# Скопируйте в .env рядом с docker-compose.yml и заполните.

# Длинная случайная строка: openssl rand -base64 48
SESSION_SECRET=eL38D1+hqDE/NhHN5ODKCiruC/jRL+IZnJdXF704OHr0VHQ4vlzXlGdECm+l0fCl
# Пароль Postgres внутри compose: openssl rand -base64 24
POSTGRES_PASSWORD=123456

# Первый суперадминистратор. Создаётся один раз при пустой базе.
SUPER_LOGIN=super
SUPER_PASSWORD=123456

# Внешний порт Nginx.
HTTP_PORT=80
# 1 — когда сайт открыт по HTTPS.
COOKIE_SECURE=0

# Сколько раз тестируемый может отправить тест по уроку.
LESSON_MAX_ATTEMPTS=1
# Соединений к Postgres на один экземпляр приложения.
PG_POOL_MAX=20
# Экземпляров приложения за Nginx. Живые комнаты квизов работают только при 1.
APP_REPLICAS=1
# Сколько дней хранить дампы базы.
BACKUP_KEEP_DAYS=14
